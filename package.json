{
  "name": "wabcs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @wabcs/server",
    "dev:client": "npm run dev --workspace @wabcs/client",
    "build": "npm run build --workspace @wabcs/client",
    "deploy:server": "npm run deploy --workspace @wabcs/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspace @wabcs/shared && npm run typecheck --workspace @wabcs/server && npm run typecheck --workspace @wabcs/client",
    "smoke": "node scripts/smoke-build.mjs",
    "bots": "node scripts/bot.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
